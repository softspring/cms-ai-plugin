{% trans_default_domain 'sfs_cms_contents' %}

{% set sfs_components_theme = 'bootstrap5' %}
{% set sfs_admin_lock_body_scroll = false %}
{% set body_classes = (body_classes|default('') ~ ' cms-content-edit-page sfs-cms-ai-content-editor-page overflow-hidden')|trim %}
{% set sfs_cms_ai_editor_agent = sfs_cms_ai_editor_agent|default({
    endpoint: '#',
    history: [],
    platforms: {},
    models_by_platform: {},
    selected_platform: null,
    selected_model: null,
    base_version_id: null,
    base_version_number: null,
    tools: {},
}) %}
{% set sfs_cms_ai_site_options = [] %}
{% for site in content_entity.sitesSorted %}
    {% set sfs_cms_ai_site_options = sfs_cms_ai_site_options|merge([{id: site ~ '', name: site|sfs_cms_site_name}]) %}
{% endfor %}

{% extends '@SfsCms/admin_layout.html.twig' %}

{% form_theme form
    '@SfsCms/forms/cms_theme.html.twig'
    '@SfsPolymorphicFormType/polymorphic-form-theme.html.twig'
    '@SfsCms/forms/modules_theme.html.twig'
    '@SfsCms/forms/types_theme.html.twig'
    '@SfsMedia/forms/media_type_theme.html.twig'
%}

{% block title %}{{ ('admin_'~content_type~'.content.meta.title')|trans({'%name%':content_entity.name}) }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/sfscmsaiplugin/styles/admin/content-editor-agent.css') }}">
{% endblock stylesheets %}

{% block body %}
    <div id="maxInputVarsMessage" data-max-input-vars="{{ maxInputVars }}" class="container-fluid bg-warning fixed-top px-5 py-3 text-center text-dark d-none" style="z-index: 10000">
        {{ 'admin_content.content.max_input_vars_raw'|trans({'%maxInputVars%': maxInputVars}, 'sfs_cms_admin')|raw }}
    </div>

    {# disable turbo for content edit #}
    {{ form_start(form, {'attr': {'novalidate':'', 'data-turbo': 'false', 'class': 'cms-content-edit-form'}}) }}
    <div class="cms-content">
        <header class="cms-content-header p-3 bg-dark border-bottom">
            <div class="container-fluid">
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                    <span class="d-flex align-items-center mb-2 mb-lg-0 text-white">
                        {{ ('admin_'~content_type~'.content.title')|trans({'%name%':content_entity.name, '%versionNumber%': prev_version.versionNumber|default('0')}) }}
                    </span>

                    <div class="col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0"></div>

                    <div class="text-end me-3 {{ form.layout.vars.choices|length <= 1 ? 'd-none' : '' }}">
                        {{ form_widget(form.layout, {'attr':{'onchange':"confirm('Si continuas se pueden eliminar datos ¿quieres continuar?') && (document.getElementById('version_create_form__ok').value = 1) && submit()"}}) }}
                    </div>

                    <div class="text-end me-3">
                        <select class="form-select {{ content_entity.locales|length <= 1 ? 'd-none' : '' }}" id="contentEditionLanguageSelection">
                            {% for locale in content_entity.locales %}
                                <option value="{{ locale|lower }}">{{ locale|upper }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="text-end me-3">
                        <select class="form-select {{ content_entity.sites|length <= 1 ? 'd-none' : '' }}" id="contentEditionSiteSelection">
                            {% for site in content_entity.sitesSorted %}
                                <option value="{{ site }}">{{ site|sfs_cms_site_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="text-end d-flex align-center">
                        {% if app.request.query.get('back') == 'versions' %}
                            <a href="{{ url('sfs_cms_admin_content_'~content_type~'_versions', {'content':content_entity.id}) }}"
                               class="btn btn-light">{{ ('admin_'~content_type~'.content.actions.cancel.button')|trans }}</a>
                        {% else %}
                            <a href="{{ url('sfs_cms_admin_content_'~content_type~'_details', {'content':content_entity.id}) }}"
                               class="btn btn-light">{{ ('admin_'~content_type~'.content.actions.cancel.button')|trans }}</a>
                        {% endif %}

                        <div class="btn-group" role="group">
                            <button name="goto" value="content" type="submit"
                                    class="btn btn-primary ms-3" id="defaultSubmitBtn">{{ ('admin_'~content_type~'.content.actions.save.button')|trans }}</button>
                            <button name="goto" id="submitBtnGroupDrop1" type="button" class="btn btn-primary dropdown-toggle"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="submitBtnGroupDrop1">
                                <li>
                                    <button class="btn btn-primary dropdown-item" name="goto"
                                            value="general">{{ ('admin_'~content_type~'.content.actions.save_and_exit.button')|trans }}</button>
                                    <button class="btn btn-primary dropdown-item" name="goto"
                                            value="preview">{{ ('admin_'~content_type~'.content.actions.save_and_preview.button')|trans }}</button>
                                    {% if not content_config.admin.publish_version.is_granted or is_granted(content_config.admin.publish_version.is_granted, form.vars.data) %}
                                        <button class="btn btn-primary dropdown-item" name="goto"
                                                value="publish">{{ ('admin_'~content_type~'.content.actions.save_and_publish.button')|trans }}</button>
                                    {% else %}
                                        <button class="btn btn-primary dropdown-item disabled"
                                                name="goto">{{ ('admin_'~content_type~'.content.actions.save_and_publish.button')|trans }}</button>
                                    {% endif %}
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <div class="cms-content-main flex-fill d-flex flex-row align-items-stretch bg-light sfs-cms-ai-content-editor-shell">
            <aside class="sfs-cms-ai-content-agent-panel bg-white border-end">
                <div
                    class="sfs-cms-ai-content-agent"
                    data-cms-ai-content-editor-agent
                    data-endpoint="{{ sfs_cms_ai_editor_agent.endpoint }}"
                    data-form-selector=".cms-content-edit-form"
                    data-form-name="{{ form.vars.full_name }}"
                    data-content-type="{{ content_type }}"
                    data-content-id="{{ content_entity.id }}"
                    data-content-name="{{ content_entity.name|e('html_attr') }}"
                    data-layout="{{ form.layout.vars.value|default(form.vars.data.layout)|e('html_attr') }}"
                    data-base-version-id="{{ sfs_cms_ai_editor_agent.base_version_id|default('') }}"
                    data-base-version-number="{{ sfs_cms_ai_editor_agent.base_version_number|default('') }}"
                    data-selected-locale-selector="#contentEditionLanguageSelection"
                    data-selected-site-selector="#contentEditionSiteSelection"
                    data-thinking-label="Thinking..."
                    data-error-prefix="Agent failed:"
                >
                    <div class="sfs-cms-ai-content-agent-header">
                        <h2 class="h5 mb-0">Armonic AI</h2>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-cms-ai-content-editor-reset>
                            <span class="bi bi-trash" aria-hidden="true"></span>
                            New chat
                        </button>
                    </div>

                    <div class="sfs-cms-ai-content-agent-thread" data-cms-ai-content-editor-thread aria-live="polite">
                        {% if sfs_cms_ai_editor_agent.history is not empty %}
                            {% for message in sfs_cms_ai_editor_agent.history %}
                                <div class="sfs-cms-ai-content-agent-message sfs-cms-ai-content-agent-message-{{ message.role }}">
                                    <div class="sfs-cms-ai-content-agent-message-body">{{ message.content }}</div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="sfs-cms-ai-content-agent-message sfs-cms-ai-content-agent-message-assistant">
                                <div class="sfs-cms-ai-content-agent-message-body">Ready.</div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="sfs-cms-ai-content-agent-status text-muted small d-none" data-cms-ai-content-editor-status>
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        <span data-cms-ai-content-editor-status-text>Thinking...</span>
                    </div>

                    <div class="alert alert-danger d-none" data-cms-ai-content-editor-error></div>
                    <div class="alert alert-warning d-none" data-cms-ai-content-editor-validation></div>

                    <div class="sfs-cms-ai-content-agent-form">
                        <textarea class="form-control" rows="4" placeholder="Instruction..." data-cms-ai-content-editor-instruction></textarea>

                        <div class="sfs-cms-ai-content-agent-controls">
                            <select class="form-select form-select-sm" data-cms-ai-content-editor-platform>
                                {% for value, label in sfs_cms_ai_editor_agent.platforms %}
                                    <option value="{{ value }}" {{ value == sfs_cms_ai_editor_agent.selected_platform ? 'selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>

                            {% set sfs_cms_ai_selected_models = sfs_cms_ai_editor_agent.models_by_platform[sfs_cms_ai_editor_agent.selected_platform]|default({}) %}
                            <select class="form-select form-select-sm" data-cms-ai-content-editor-model>
                                {% for value, label in sfs_cms_ai_selected_models %}
                                    <option value="{{ value }}" {{ value == sfs_cms_ai_editor_agent.selected_model ? 'selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <button type="button" class="btn btn-primary w-100" data-cms-ai-content-editor-submit>
                            <span class="bi bi-send me-1" aria-hidden="true"></span>
                            Send
                        </button>
                    </div>

                    <script type="application/json" data-cms-ai-content-editor-history>{{ sfs_cms_ai_editor_agent.history|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
                    <script type="application/json" data-cms-ai-content-editor-models>{{ sfs_cms_ai_editor_agent.models_by_platform|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
                    <script type="application/json" data-cms-ai-content-editor-locales>{{ content_entity.locales|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
                    <script type="application/json" data-cms-ai-content-editor-sites>{{ sfs_cms_ai_site_options|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
                </div>
            </aside>

            <div class="sfs-cms-ai-content-editor-main flex-fill min-vh-0">
                <div class="row w-100 mx-0">
                    <div class="col px-0">
                        {{ form_errors(form) }}
                        {% include layout_config.edit_template %}
                    </div>
                    <div class="col-2 min-vh-100 bg-white d-none" id="content-form"></div>
                </div>
            </div>
        </div>
    </div>
    {#        <iframe id="previewFrame" src="/preview.html"></iframe> #}
    {#        <button onclick="document.getElementById('previewFrame').contentWindow.document.getElementsByTagName('body')[0].innerHTML = 'Otra cosa'; return false;">Change</button> #}


    {{ form_widget(form.module_prototypes_collection) }}
    {{ form_rest(form) }}
    {{ form_end(form) }}

    <script type="text/javascript">
        document.getElementById("version_create_form__ok").value = 0;
    </script>

    {% if alert|default(false) and alert[0] is defined and alert[1] is defined %}
        <div class="cms-content-edit-alerts fixed-top w-50 float-right m-5">
            <div class="alert alert-{{ alert[0]|replace({'error':'danger'}) }} alert-dismissible fade show" role="alert">
                {{ alert[1]|trans(alert[2]|default([]), alert[3]|default('sfs_cms_contents'))|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    {% else %}
        {% include '@SfsComponents/flash-messages/alerts.html.twig' %}
    {% endif %}

    {% include '@SfsMedia/forms/media_type_modal.html.twig' %}
{% endblock body %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('bundles/sfscmsaiplugin/scripts/admin/content-editor-agent.js') }}"></script>
{% endblock javascripts %}
